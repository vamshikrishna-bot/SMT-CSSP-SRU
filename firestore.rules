rules_version = '2';
service cloud.firestore {
  match /databases/{db}/documents {
    // each junior can read/write only their own document (login email = <rollno>@cssp.sru)
    match /users/{roll} {
      allow read, write: if request.auth != null
        && request.auth.token.email == roll.lower() + '@cssp.sru';
    }
  }
}
